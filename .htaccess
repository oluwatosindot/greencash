# Disable directory listing
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# PHP error display — off in production, errors logged to error_log
php_flag display_errors off
php_flag log_errors on

# Enable rewrite engine — used for directory blocking and (after SSL) HTTPS redirect
RewriteEngine On

# Block direct HTTP access to sensitive directories.
# PHP can still read these files server-side (require_once, fopen, etc).
RewriteRule ^(includes|config|cron|database|vendor|uploads)/ - [F,L]
# Uploaded documents (payslips, IDs, bank statements) are gated through
# serve-document.php which checks the requester is an authenticated admin.

# Canonicalize to https://www.greencash.co.za in a single 301 hop.
# Fires when the request is HTTP, or the host is not exactly www.greencash.co.za.
# This prevents the unstyled-page bug on the bare domain (CSP 'self' treats
# greencash.co.za and www.greencash.co.za as different origins, so assets built
# from APP_URL=https://www.greencash.co.za get blocked when the page is served
# from the bare host).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.greencash\.co\.za$ [NC]
RewriteRule ^(.*)$ https://www.greencash.co.za/$1 [L,R=301]

# Clean URLs — serve /login as /login.php (and the same for any other root-level *.php).
# Internal rewrite only (no redirect), so form actions pointing at .php URLs still work
# and POST data is never lost to a 30x redirect. Both /login and /login.php load the
# same page; just the cleaner URL is now valid too.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Block access to sensitive file extensions if accidentally placed in docroot.
# manifest.json (PWA) is explicitly allowed below.
<FilesMatch "\.(sql|log|md|lock|yml|env|gitignore|cpanel\.yml)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>
<Files "manifest.json">
    Require all granted
</Files>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS — only after SSL is confirmed working, otherwise browsers cache the HTTPS pin
    # and you can't fall back to HTTP during troubleshooting.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self';"
</IfModule>

# Note: uploads/.htaccess separately disables PHP execution in that directory.
